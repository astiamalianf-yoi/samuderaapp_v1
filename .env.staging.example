# STAGING settings for samudraapp.com — copy to /root/samudra-staging/.env and fill the <...> values.
# Staging is a full second copy of the stack on the same server: its own containers, database,
# Redis, bot number and WhatsApp test groups. All UAT happens here, so production stays clean.
# Never copy production's secrets here, and never put real field-study groups here.

# --- Names: keep these, they keep staging apart from production (samudra-com / samudra-*)
COMPOSE_PROJECT_NAME=samudra-staging
CONTAINER_PREFIX=samudra-staging
STAGE_LABEL=STAGING

# --- Addresses (add both as DNS A records pointing to the server, 43.156.242.107)
APP_DOMAIN=staging.samudraapp.com
APP_APEX_DOMAIN=staging.samudraapp.com
API_DOMAIN=api-staging.samudraapp.com

# --- Secrets: new random values, different from production (e.g. `openssl rand -hex 32`)
FISHERMAN_HASH_SECRET=<new random value>
RESEARCH_API_KEY=<new random value>
OPENCLAW_HOOK_TOKEN=<new random value>
OPENCLAW_GATEWAY_TOKEN=<new random value>

# --- Staging's own bot (the second WhatsApp number). Its OpenClaw settings live in these folders,
# separate from production's /root/.openclaw-samudra.
SAMUDRA_OPENCLAW_DIR=/root/.openclaw-samudra-staging
SAMUDRA_OPENCLAW_SECRETS_DIR=/root/.openclaw-samudra-staging-auth
OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789
# Test groups only (Uji Lampuuk, Uji Lhoknga); Uji Coba stays out of this list.
OPENCLAW_BEACH_GROUPS=pantai_lampuuk=<Uji Lampuuk id>@g.us,pantai_lhoknga=<Uji Lhoknga id>@g.us

# --- Test helpers: on in staging only
BMKG_SIM_ENABLED=true
TRUST_INDEX_MODE=adaptive
# Group warning class by majority of registered fishermen (needs at least GROUP_MAJORITY_MIN at the beach).
# For UAT you may lower the minimum, e.g. 3, so a few test numbers can reach it.
GROUP_CLASS_MODE=majority
GROUP_MAJORITY_MIN=10
# "Profil Anda" box (five tipping points, colours only): shown by default; false hides it
PROFILE_CLASS_VISIBLE=true
# Morning message off by default in staging (trigger it by hand with the research key when testing H-04)
MORNING_BROADCAST_TIME=

# --- Push notifications: a separate VAPID key pair for staging (`bunx web-push generate-vapid-keys`)
VAPID_SUBJECT=mailto:<your email>
VAPID_PUBLIC_KEY=<staging public key>
VAPID_PRIVATE_KEY=<staging private key>
